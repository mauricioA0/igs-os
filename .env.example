DATABASE_URL=postgres://igs:igs@localhost:5433/igs
ANTHROPIC_API_KEY=
# Shared secret for the MCP endpoint (Authorization: Bearer <token>)
MCP_TOKEN=change-me
OPENAI_API_KEY=
# Model per role (ids verified via the Models API 2026-10-22). Reasoning = expensive, use sparingly.
IGS_LLM_MODELS={"agent":"gpt-6.1-sol","chat":"gpt-6-luna","extractor":"gpt-6-luna","judge":"gpt-6.1-sol","simulator":"gpt-6-luna","reasoning":"gpt-6-astra","fast":"gpt-6-luna"}
# Deployment-wide model spend fuse (USD per UTC day, API + workers) and default output
# ceiling. Empty = off. Needs migration 0005 (llm_spend_daily).
IGS_LLM_DAILY_BUDGET_USD=
IGS_LLM_MAX_OUTPUT_TOKENS=
# Shared with the web proxy: lets it forward the browser IP (x-igs-client-ip) for rate limits.
IGS_PROXY_SHARED_SECRET=
